pipeline {
    agent any
    
    environment {
        APP_NAME = 'jenkins-microservices-app'
    }
    
    stages {
        stage('Preparación y Validación') {
            steps {
                echo '🔍 Validando estructura del proyecto...'
                sh '''
                    for service in api-gateway user-service product-service; do
                        if [ ! -d "services/$service" ]; then
                            echo "❌ Servicio $service no encontrado"
                            exit 1
                        fi
                        if [ ! -f "services/$service/package.json" ]; then
                            echo "❌ package.json no encontrado en $service"
                            exit 1
                        fi
                    done
                    echo "✅ Estructura validada correctamente"
                '''
            }
        }
        
        stage('Pruebas de Contrato') {
            agent {
                docker {
                    image 'node:18-alpine'
                    args '-u root'
                }
            }
            steps {
                echo '📋 Verificando contratos entre servicios...'
                sh '''
                    echo "Verificando User Service..."
                    node scripts/validate-contract.js services/user-service shared/contracts/user-contract.json
                    
                    echo "Verificando API Gateway..."
                    node scripts/validate-contract.js services/api-gateway shared/contracts/user-contract.json
                '''
            }
        }
        
        stage('Construcción y Prueba de Imágenes Docker') {
            steps {
                echo '🏗️ Construyendo imágenes de microservicios...'
                sh '''
                    echo "Construyendo API Gateway..."
                    docker build -t api-gateway:test -f services/api-gateway/Dockerfile services/api-gateway
                    
                    echo "Construyendo User Service..."
                    docker build -t user-service:test -f services/user-service/Dockerfile services/user-service
                    
                    echo "Construyendo Product Service..."
                    docker build -t product-service:test -f services/product-service/Dockerfile services/product-service
                    
                    echo "✅ Todas las imágenes fueron construidas exitosamente"
                '''
            }
            post {
                always {
                    sh '''
                        echo "🧹 Limpiando imágenes de prueba..."
                        docker rmi api-gateway:test user-service:test product-service:test || true
                    '''
                }
            }
        }
    }
    
    post {
        success {
            echo '====================================================='
            echo '🎉 ¡PIPELINE DE LA PRÁCTICA 1 COMPLETADO CON ÉXITO! 🎉'
            echo '====================================================='
        }
        failure {
            echo '❌ Pipeline falló.'
        }
        always {
            echo '🧹 Limpiando workspace...'
            cleanWs()
        }
    }
}